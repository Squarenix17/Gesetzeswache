  <norm builddate="20260512120001" doknr="BJNR000000000BJNE000101000">
    <metadaten>
      <jurabk>MiLoG</jurabk>
      <enbez>§ 1</enbez>
      <titel format="parat">Mindestlohn</titel>
    </metadaten>
    <textdaten>
      <text>
        <Content>
          <P nr="1">Jeder Arbeitnehmer hat Anspruch auf Zahlung eines Arbeitsentgelts mindestens in Höhe des Mindestlohns durch den Arbeitgeber.</P>
          <P nr="2">Die Höhe des Mindestlohns beträgt ab dem 1. Oktober 2022 brutto 12 Euro je Zeitstunde.</P>
        </Content>
      </text>
    </textdaten>
  </norm>

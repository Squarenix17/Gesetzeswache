# Go build artifacts
/bin/
/dist/
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out

# Go coverage
coverage.out
coverage.html
*.coverprofile

# Vendor (prefer Go modules; go.sum remains tracked)
/vendor/

# Local Go workspace files (optional per-developer)
go.work
go.work.sum

# Top-level documentation (generated or local)
/docs/

# Secrets and credentials
.env
.env.*
*.pem
credentials.json
*credentials*
.secrets/

# Local runtime data stores
/data/
*.db
*.db-journal
*.bolt
gesetzeswache.db

# IDE (keep .cursor/ trackable)
.idea/
.vscode/

# OS noise
.DS_Store
Thumbs.db

# Ephemeral caches and logs
.cache/
tmp/
*.log
/gew

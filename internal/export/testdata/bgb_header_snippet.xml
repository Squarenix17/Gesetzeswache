  <norm builddate="20251013215509" doknr="BJNR001950896BJNE000009377">
    <metadaten>
      <jurabk>BGB</jurabk>
      <enbez>§ 5</enbez>
      <titel format="parat">Rechtsstellung</titel>
    </metadaten>
    <textdaten>
      <text>
        <Content>
          <P nr="1">Gesetze gelten im Hoheitsgebiet der Bundesrepublik Deutschland, soweit nicht in den Gesetzen selbst etwas anderes bestimmt ist.</P>
        </Content>
      </text>

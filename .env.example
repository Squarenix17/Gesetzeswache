# Gesetzeswache (gew) — example environment
# Copy to .env and adjust. Values match internal/config defaults unless noted.
#   cp .env.example .env

# --- Release / Docker (optional; defaults match repo-root VERSION file) ---
# GEW_VERSION=0.5.1

# --- Server / store ---
GEW_HTTP_ADDR=:8080
GEW_STORE_PATH=gesetzeswache.db
# Empty = POST /v1/recheck fails closed (401). For compose/production:
#   export GEW_SHARED_SECRET="$(openssl rand -hex 32)"
GEW_SHARED_SECRET=

# --- Matching / freshness ---
GEW_MATCH_THRESHOLD=0.75
GEW_FRESHNESS_MAX_AGE=6h
GEW_UNMATCHED_GRACE=72h

# --- Sync intervals ---
GEW_TOC_INTERVAL=6h
GEW_GII_FEED_INTERVAL=15m
GEW_BGBL_FEED_INTERVAL=15m
GEW_ELI_PROBE_INTERVAL=30m

# --- Outbound HTTP ---
GEW_HTTP_TIMEOUT=60s
GEW_REQUEST_MIN_GAP=250ms

# --- Official source URLs (allowlisted hosts only) ---
GEW_GII_BASE=https://www.gesetze-im-internet.de
GEW_GII_TOC_URL=https://www.gesetze-im-internet.de/gii-toc.xml
GEW_GII_FEED_URL=https://www.gesetze-im-internet.de/aktuDienst-rss-feed.xml
GEW_BGBL_FEED1_URL=https://www.recht.bund.de/rss/feeds/rss_bgbl-1.xml
GEW_BGBL_FEED2_URL=https://www.recht.bund.de/rss/feeds/rss_bgbl-2.xml
GEW_ELI_BASE=https://www.recht.bund.de/eli/bund

# --- Features ---
GEW_ENABLE_HEURISTIC=true
GEW_ENABLE_EXPORT=true
GEW_EXPORT_CACHE_MAX=64
GEW_REFUSE_EXPORT_STALE=false
GEW_MAX_OPERATIVE_BUNDLE=8
GEW_STAND_REFRESH_MAX=10
GEW_DISCOVERY_ENABLED=true
GEW_DISCOVERY_MAX_PER_CYCLE=50

# --- Data paths ---
GEW_VARIANTS_PATH=variants/variants.tsv
GEW_LINKED_INSTRUMENTS_PATH=variants/linked_instruments.tsv
GEW_FORTSCHREIBUNG_FAMILIES_PATH=variants/fortschreibung_families.tsv

# Go build artifacts
/bin/
/dist/
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out

# Go coverage
coverage.out
coverage.html
*.coverprofile

# Vendor (prefer Go modules; go.sum remains tracked)
/vendor/

# Local Go workspace files (optional per-developer)
go.work
go.work.sum

# Top-level documentation (generated or local)
/docs/

# Secrets and credentials
.env
.env.*
!.env.example
*.pem
credentials.json
*credentials*
.secrets/

# Local runtime data stores
/data/
*.db
*.db-journal
*.bolt
gesetzeswache.db

# IDE / Cursor: keep full ECC locally; track only shared Go agent rules + Go agents
.idea/
.vscode/
.cursor/*
!.cursor/rules/
!.cursor/agents/
.cursor/rules/*
.cursor/agents/*
!.cursor/rules/golang-coding-style.mdc
!.cursor/rules/golang-hooks.mdc
!.cursor/rules/golang-patterns.mdc
!.cursor/rules/golang-security.mdc
!.cursor/rules/golang-testing.mdc
!.cursor/rules/common-security.mdc
!.cursor/rules/common-coding-style.mdc
!.cursor/rules/common-testing.mdc
!.cursor/rules/common-patterns.mdc
!.cursor/agents/go-reviewer.md
!.cursor/agents/go-build-resolver.md

# OS noise
.DS_Store
Thumbs.db

# Ephemeral caches and logs
.cache/
tmp/
*.log
/gew
